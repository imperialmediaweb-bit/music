# Profile: Dark House
#
# Usage: copy this file to .env.darkhouse, then run:
#   python main.py run --profile darkhouse
#   python main.py schedule --profile darkhouse
#
# Only variables listed here override the main .env. Everything else
# (OPENAI_API_KEY, HF_API_KEY, TuneCore / SoundCloud / aimusicfactory
# state files, HEADLESS, MUSIC_PLATFORM, SONGS_PER_CLIP, etc.) is inherited
# from .env, so the Dark House channel behaves exactly like Afro House —
# only the genre, style prompt, cover vibe, YouTube channel, and TikTok
# opt-out differ. Dark House posts to YouTube only (no TikTok).

# --- Genre & music style ---
MUSIC_GENRE=Dark House

MUSIC_STYLE_PROMPT=deep house, dark house, emotional night vibe, 120 bpm, atmospheric, dreamy, minimal beat, deep bass, reverb heavy, echo effects, underground club mood, soft female vocals, breathy whisper voice, sensual and melancholic tone, catchy repetitive hook, smooth transitions, modern sound. lyrics about love, night, connection, darkness, emotional feeling, simple and hypnotic structure. make it sound like a late night drive, neon lights, rain, cinematic mood, but fully original composition, not similar to any existing song. strong drop, melodic, immersive atmosphere, viral potential, TikTok friendly.

# --- Thumbnail / cover art ---
THUMBNAIL_STYLE_PROMPT=late night drive aesthetic, neon lights reflecting on wet asphalt, rain on window, cinematic moody atmosphere, dark house vibe, underground club mood, soft female silhouette, melancholic and sensual, dreamy blurred lights, purple and blue neon palette, cinematic wide shot, film grain
THUMBNAIL_TEXT_STYLE=stylized

# --- Skip TikTok entirely on the Dark House channel (YouTube-only) ---
SKIP_TIKTOK=true

# --- Separate YouTube cookies so uploads land on the Dark House channel ---
# Export these cookies AFTER switching to the Dark House channel in YouTube Studio
# (same Google / email account, different channel).
YOUTUBE_COOKIE_FILE=cookies/youtube_darkhouse_cookies.json

# --- Output directory isolated so files do not mix with Afro House ---
OUTPUT_DIR=output/darkhouse

# --- Optional: different schedule so both channels do not post at the same hour ---
SCHEDULE_CRON=0 18 * * *
