# OpenAI API Key (required for concept + thumbnail generation)
OPENAI_API_KEY=sk-your-key-here

# Hugging Face API Key (for MusicGen AI music generation — free)
# Get your key at https://huggingface.co/settings/tokens
HF_API_KEY=hf_your-key-here

# Music genre (e.g. Afro House, Lo-Fi, Trap, EDM, Jazz, Hip-Hop, Ambient)
MUSIC_GENRE=Afro House

# Custom music style prompt (leave empty for default)
# Describes the sound, instruments, tempo, mood for AI music generation
MUSIC_STYLE_PROMPT=

# Custom thumbnail style prompt (leave empty for default African mask)
# Describes the visual style for DALL-E thumbnail generation
THUMBNAIL_STYLE_PROMPT=

# Scheduler cron expression (default: daily at 10:00 AM)
SCHEDULE_CRON=0 10 * * *

# ── Recovery Pipeline v3 — Phase 1: Scheduling ──
# The weekly upload plan lives in config.py (UPLOAD_SCHEDULE = Tue/Thu/Sat 17:00).
# These env vars tune the guardrails around it:
# Timezone the schedule times are interpreted in.
SCHEDULER_TIMEZONE=Europe/Bucharest
# Hard cap on uploads per calendar week, enforced before ANY upload.
MAX_UPLOADS_PER_WEEK=3
# Minimum hours between two uploads (doubles as the anti-duplication lock).
MIN_HOURS_BETWEEN_UPLOADS=24

# Browser cookie files for authenticated uploads
YOUTUBE_COOKIE_FILE=cookies/youtube_cookies.json
TIKTOK_COOKIE_FILE=cookies/tiktok_cookies.json

# Output directory
OUTPUT_DIR=output

# Run browser in headless mode (true/false)
HEADLESS=true

# Music platform: aimusicfactory, suno, udio, or musicgen
MUSIC_PLATFORM=aimusicfactory

# Number of songs per clip: 2, 4, 6, or 8
SONGS_PER_CLIP=2

# Skip SoundCloud upload (set to true to disable)
SKIP_SOUNDCLOUD=false
